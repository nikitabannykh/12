# Полный зал — переменные окружения.
# Локально: cp .env.example .env.local. На Vercel: Settings → Environment Variables, затем Redeploy.
# Для демо достаточно оставить всё как есть. Подробные инструкции — README.md, раздел «Где взять ключи».

# ─── Основное ────────────────────────────────────────────────
# Адрес сервиса без «/» в конце: из него строятся OAuth-редиректы, ссылки в объявлениях и вебхук Telegram.
# Пусто → на Vercel берётся VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, локально http://localhost:3000.
APP_URL=http://localhost:3000

# Секрет подписи сессий и шифрования токенов кабинетов (≥16 символов, лучше 32+): openssl rand -hex 32
# Пусто → секрет выводится из DATABASE_URL; тогда смена пароля базы сбросит сессии и сохранённые токены.
# В продакшене без APP_SECRET и без базы сервис не запустится (если не задан ALLOW_INSECURE).
# Задайте один раз и не меняйте.
APP_SECRET=

# Postgres. Продакшен: pooled-строка Neon (интеграция Vercel → Neon добавляет её сама).
# Пусто → встроенная PGlite (только для разработки и демо).
DATABASE_URL=
# Yandex Managed PostgreSQL и другие базы со своим центром сертификации: сертификат CA (PEM-текст, путь к .pem или PEM в base64).
# С ним проверяются сертификат и имя хоста (как sslmode=verify-full). Для Yandex: https://storage.yandexcloud.net/cloud-certs/CA.pem
# Без него: sslmode из DATABASE_URL, а если его нет — шифрование без проверки сертификата (Neon, Supabase). См. docs/deploy-ru.md.
# PG_CA_CERT=
# Соединений к базе на один экземпляр приложения (по умолчанию 5)
# PG_POOL_MAX=5
# Запасной вариант, если DATABASE_URL не задан (устаревшие переменные интеграций Vercel Postgres / Neon).
# POSTGRES_URL=
# Папка встроенной PGlite. По умолчанию .data/pglite (на Vercel — /tmp/pglite, данные не сохраняются).
# PGLITE_DIR=

# Секрет для запуска робота по расписанию: заголовок «Authorization: Bearer <CRON_SECRET>».
# Vercel НЕ создаёт эту переменную сам — добавьте вручную;
# Vercel Cron передаёт её в заголовке. Тот же секрет нужен в GitHub Actions (Secrets → CRON_SECRET).
# openssl rand -hex 24
CRON_SECRET=

# Демо-вход и демо-кабинет без настоящих площадок. Включено всегда, кроме значения false.
ALLOW_DEMO=true

# Разрешить работу в продакшене без APP_SECRET и без базы (только для показа демо, небезопасно).
# Старое имя ALLOW_INSECURE_SECRET тоже поддерживается.
# ALLOW_INSECURE=

# ─── Вход через Google ───────────────────────────────────────
# console.cloud.google.com → Google Auth Platform → Clients → Web application
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
# Пусто → доступен только демо-вход.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Яндекс Директ + Метрика ─────────────────────────────────
# oauth.yandex.ru → «Для авторизации пользователей» → платформа «Веб-сервисы»
# Права: direct:api, metrika:read, metrika:write
# Redirect URI: {APP_URL}/api/connect/yandex/callback
# Плюс одобренная заявка на доступ к API в интерфейсе Директа (раздел «API»).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# true → песочница Директа (api-sandbox.direct.yandex.com), можно до одобрения заявки на API.
YANDEX_DIRECT_SANDBOX=false
# Ставка НДС для пересчёта недельных лимитов: лимит в Директ передаётся как бюджет / (1 + ставка).
# По умолчанию 0.22. Поставьте 0, если окажется, что лимиты в кабинете задаются с НДС.
# YANDEX_DIRECT_VAT=0.22
# НДС для сумм VK Рекламы (лимит отправляем без НДС, расход пересчитываем с НДС); 0 — если суммы в кабинете уже с НДС
# VK_ADS_VAT=0.22
# Только вне Vercel за своим прокси: заголовок с настоящим IP клиента (x-real-ip, cf-connecting-ip)
# TRUSTED_IP_HEADER=
# Переопределение адресов API (для тестов и прокси). По умолчанию выбираются по YANDEX_DIRECT_SANDBOX.
# YANDEX_DIRECT_API_URL=https://api.direct.yandex.com/json/v501
# YANDEX_DIRECT_REPORTS_URL=https://api.direct.yandex.com/json/v5/reports
# Баланс общего счёта Директа (API Live v4). По умолчанию выбирается по YANDEX_DIRECT_SANDBOX.
# YANDEX_DIRECT_V4_URL=https://api.direct.yandex.ru/live/v4/json/
# Management API Метрики (счётчик, цели, офлайн-конверсии «Записался»). Для тестов и прокси.
# METRIKA_API_URL=https://api-metrika.yandex.net/management/v1

# ─── VK Реклама ──────────────────────────────────────────────
# ads.vk.com → Настройки → Доступ к API. client_secret показывается 10 минут — сохраните сразу.
# Для подключения кабинетов владельцев нужен Authorization Code Grant (выдаётся отдельно, ads_api@vk.team).
# Redirect URI: {APP_URL}/api/connect/vk/callback
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=
# ID формата размещения («пакета») для объявлений «трафик на сайт», если автоподбор не подошёл.
# VK_ADS_PACKAGE_ID=
# Переопределение адреса API (для тестов и прокси).
# VK_ADS_API_URL=https://ads.vk.com/api

# ─── Генерация: YandexGPT + YandexART (Yandex Cloud) ─────────
# Сервисный аккаунт с ролями ai.languageModels.user и ai.imageGeneration.user.
# API-ключ с областями yc.ai.languageModels.execute и yc.ai.imageGeneration.execute.
# Пусто → тексты из шаблонов ниш, без генерации фото.
YANDEX_CLOUD_API_KEY=
# ID каталога, b1g…
YANDEX_CLOUD_FOLDER_ID=
# yandexgpt/latest (качество, по умолчанию) или yandexgpt-lite/latest (дешевле)
YANDEX_GPT_MODEL=yandexgpt/latest

# ─── Автозаполнение анкеты по ссылке (необязательно) ─────────
# Без ключей работает: сайт (schema.org, прайс), публичные страницы Яндекс Карт и 2ГИС, Taplink, DIKIDI.
# Ключи — запасной путь, если площадка не отдаёт страницу роботу (капчу сервис не обходит).
# 2ГИС Places API: platform.2gis.ru → ключ «Places API» (catalog.api.2gis.com/3.0/items/byid)
# DGIS_API_KEY=
# Яндекс «API поиска по организациям»: developer.tech.yandex.ru → ключ «API Поиска по организациям» (search-maps.yandex.ru/v1)
# YANDEX_PLACES_API_KEY=

# ─── Telegram: заявки и утренняя сводка владельцу ────────────
# @BotFather → /newbot → токен. Вебхук {APP_URL}/api/notify/telegram ставится сам при https-адресе.
# Бот присылает заявки с кнопками «Записался / Не дозвонились / Спам», сводку с кнопками «Отменить»
# и предупреждение, когда деньги в кабинете кончатся через ≤ 3 дня.
# Пусто → уведомлений нет.
TELEGRAM_BOT_TOKEN=
# Имя бота без @. Пусто → узнаём через getMe.
# TELEGRAM_BOT_USERNAME=
# Свой адрес Bot API (Local Bot API или прокси), если api.telegram.org недоступен с хостинга.
# TELEGRAM_API_URL=https://api.telegram.org

# ─── Задаёт Vercel сам — вручную не указывать ────────────────
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_PROJECT_ID, NODE_ENV
