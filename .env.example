# «Самоход» — переменные окружения.
# Локально: cp .env.example .env.local. На Vercel: Settings → Environment Variables, затем Redeploy.
# Для демо достаточно оставить всё как есть. Подробные инструкции — README.md, раздел «Где взять ключи».
# Пометки: [обязательно] — без неё продакшен не работает; [рекомендуется]; [необязательно] — есть разумное значение по умолчанию.
# Проверить, что настроено (только да/нет, без значений): GET {APP_URL}/api/health

# ─── Основное ────────────────────────────────────────────────
# [рекомендуется] Адрес сервиса без «/» в конце: из него строятся OAuth-редиректы, ссылки в объявлениях и вебхук Telegram.
# Пусто → на Vercel берётся VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, локально http://localhost:3000.
APP_URL=http://localhost:3000

# [обязательно в продакшене] Секрет подписи сессий и шифрования токенов кабинетов (≥16 символов, лучше 32+): openssl rand -hex 32
# Пусто, но есть DATABASE_URL → секрет выводится из строки подключения (так сейчас работает прод на Vercel + Neon;
#   в лог пишется предупреждение SECURITY). Смена пароля базы тогда сбросит сессии и сохранённые токены.
#   Перейти на APP_SECRET можно в любой момент: старые сессии и токены продолжат открываться прежним ключом.
# Пусто и нет базы → любая production-сборка (next start, Docker, Vercel) не запустится, если не задан ALLOW_INSECURE.
# Задайте один раз и не меняйте.
APP_SECRET=

# [обязательно в продакшене] Postgres. Продакшен: pooled-строка Neon (интеграция Vercel → Neon добавляет её сама).
# Пусто → встроенная PGlite (только для разработки и демо).
# Регион функций Vercel (vercel.json → regions) стоит ставить рядом с регионом базы Neon — сейчас не задан
# (регион Neon неизвестен); каждый запрос к базе через океан — +100…150 мс. Neon: Project settings → Region.
DATABASE_URL=
# [необязательно] Yandex Managed PostgreSQL и другие базы со своим центром сертификации: сертификат CA (PEM-текст, путь к .pem или PEM в base64).
# С ним проверяются сертификат и имя хоста (как sslmode=verify-full). Для Yandex: https://storage.yandexcloud.net/cloud-certs/CA.pem
# Без него: sslmode из DATABASE_URL, а если его нет — шифрование без проверки сертификата (Neon, Supabase). См. docs/deploy-ru.md.
# PG_CA_CERT=
# [необязательно] Соединений к базе на один экземпляр приложения (по умолчанию 5)
# PG_POOL_MAX=5
# [необязательно] Запасной вариант, если DATABASE_URL не задан (устаревшие переменные интеграций Vercel Postgres / Neon).
# POSTGRES_URL=
# [необязательно] Папка встроенной PGlite. По умолчанию .data/pglite (на Vercel — /tmp/pglite, данные не сохраняются).
# PGLITE_DIR=

# [обязательно в продакшене] Секрет для запуска робота по расписанию: заголовок «Authorization: Bearer <CRON_SECRET>».
# Vercel НЕ создаёт эту переменную сам — добавьте вручную; Vercel Cron передаёт её в заголовке.
# Тот же секрет нужен в GitHub Actions (Secrets → CRON_SECRET, плюс APP_URL). openssl rand -hex 24
CRON_SECRET=

# [необязательно] Демо-вход и демо-кабинет без настоящих площадок. Включено всегда, кроме значения false.
# Демо-аккаунты удаляются через 14 дней (уборка в /api/cron/run), у них урезанные квоты и шаблонные тексты.
# Демо-вход без регистрации и тренировочный кабинет: только для разработки. В продакшене не задавайте
ALLOW_DEMO=true

# [необязательно, небезопасно] Разрешить production-сборку без APP_SECRET и без базы (только для показа демо).
# Старое имя ALLOW_INSECURE_SECRET тоже поддерживается.
# ALLOW_INSECURE=

# [необязательно] Только вне Vercel за своим прокси: заголовок с настоящим IP клиента (x-real-ip, cf-connecting-ip).
# Без него лимиты «по IP» не применяются (x-forwarded-for подделывается клиентом).
# TRUSTED_IP_HEADER=
# [после переезда] Прежние адреса сервиса через запятую: с них принимаются заявки и формы (прокси со старого адреса).
# LEGACY_ORIGINS=https://polny-zal.vercel.app
# [после переезда] Строка старой базы: если раньше APP_SECRET не был задан, ключ шифрования выводился из неё —
# по ней токены кабинетов и сессии продолжают открываться. На ВМ берётся из NEON_DATABASE_URL.
# LEGACY_DATABASE_URL=

# ─── Вход через Google ───────────────────────────────────────
# [необязательно] console.cloud.google.com → Google Auth Platform → Clients → Web application
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
# Пусто → кнопки Google нет; остаётся вход по почте.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Вход через Яндекс ───────────────────────────────────────
# [необязательно] Отдельное приложение на oauth.yandex.ru «Для авторизации пользователей» (не приложение Директа):
# права login:email и login:info, Redirect URI: {APP_URL}/api/auth/yandex/callback. Пусто → кнопки «Войти через Яндекс» нет.
YANDEX_LOGIN_CLIENT_ID=
YANDEX_LOGIN_CLIENT_SECRET=

# ─── Почта: подтверждение адреса, восстановление пароля, вход по ссылке ───
# [рекомендуется] Регистрация и вход по почте и паролю работают и без неё; без SMTP_URL нельзя восстановить пароль по почте
# (при `next dev` ссылка печатается в консоль; в production-сборке — никогда) и нет кнопки «Войти по ссылке на почту».
# С SMTP_URL пользователь с неподтверждённой почтой не может подключить Telegram и рекламные кабинеты
# («Подтвердите почту — ссылка в письме»): защита от регистрации на чужой адрес. Без SMTP_URL это ограничение выключено.
# Яндекс 360: id.yandex.ru → Безопасность → Пароли приложений → Почта. Mail.ru: Настройки → Безопасность → Пароли для внешних приложений.
# Логин с «@» — как %40. Пример: smtps://robot%40example.ru:app-password@smtp.yandex.ru:465 (Mail.ru: smtp.mail.ru:465)
# json:// — тестовый режим: письма не отправляются, а печатаются в лог сервера («[mail:json] …»).
SMTP_URL=
# [необязательно] Отправитель; адрес должен совпадать с логином SMTP. Пусто → логин из SMTP_URL.
MAIL_FROM=

# ─── Яндекс Директ + Метрика ─────────────────────────────────
# [для работы с Яндексом] oauth.yandex.ru → «Для авторизации пользователей» → платформа «Веб-сервисы»
# Права (scopes): direct:api, metrika:read, metrika:write
# Redirect URI: {APP_URL}/api/connect/yandex/callback
# Плюс одобренная заявка на доступ к API в интерфейсе Директа (Инструменты → API → «Мои заявки»).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# [необязательно] true → песочница Директа (api-sandbox.direct.yandex.com), можно до одобрения заявки на API.
YANDEX_DIRECT_SANDBOX=false
# [необязательно] Ставка НДС для пересчёта недельных лимитов: лимит в Директ передаётся как бюджет / (1 + ставка).
# По умолчанию 0.22. Поставьте 0, если окажется, что лимиты в кабинете задаются с НДС.
# YANDEX_DIRECT_VAT=0.22
# [необязательно] Переопределение адресов API (для тестов и прокси). По умолчанию выбираются по YANDEX_DIRECT_SANDBOX.
# YANDEX_DIRECT_API_URL=https://api.direct.yandex.com/json/v501
# YANDEX_DIRECT_REPORTS_URL=https://api.direct.yandex.com/json/v5/reports
# Баланс общего счёта и Wordstat-отчёты Директа (API Live v4). По умолчанию выбирается по YANDEX_DIRECT_SANDBOX.
# YANDEX_DIRECT_V4_URL=https://api.direct.yandex.ru/live/v4/json/
# [необязательно] Management API Метрики (счётчик, цели, офлайн-конверсии «Записался») и Reporting API — для тестов и прокси.
# METRIKA_API_URL=https://api-metrika.yandex.net/management/v1
# METRIKA_STAT_URL=https://api-metrika.yandex.net/stat/v1
# [необязательно] Модель атрибуции Метрики в отчётах робота: last (по умолчанию — источник самого визита), first, lastsign,
# last_yandex_direct_click, cross_device_last_significant и др. (см. документацию Reporting API, «атрибуция»).
# METRIKA_ATTRIBUTION=last

# ─── VK Реклама ──────────────────────────────────────────────
# [для работы с VK] ads.vk.com → Настройки → Доступ к API. client_secret показывается 10 минут — сохраните сразу.
# Для подключения кабинетов владельцев нужен Authorization Code Grant (выдаётся отдельно, ads_api@vk.team).
# Redirect URI: {APP_URL}/api/connect/vk/callback
# Без них владелец всё равно может подключить свой кабинет по собственным ключам API (Настройки → «по ключам»).
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=
# [необязательно] ID формата размещения («пакета») для объявлений «трафик на сайт», если автоподбор не подошёл.
# VK_ADS_PACKAGE_ID=
# [необязательно] 0 — не запрашивать список форматов (banner_formats) и брать формат по умолчанию.
# VK_ADS_FORMAT_LOOKUP=1
# [необязательно] 0 — не пытаться создавать пиксель VK (Top@Mail.ru) автоматически.
# VK_ADS_CREATE_PIXEL=1
# [необязательно] 0 — не использовать пиксель VK для цели с ценой (оптимизация по конверсиям).
# VK_PIXEL=1
# [необязательно] 0 — не показывать в радиусе вокруг адреса (тогда весь город).
# VK_LOCAL_GEO=1
# [необязательно] Радиус показа вокруг салона, м (500…10000). По умолчанию: Москва/СПб 2000, миллионники 3000, остальные 5000.
# VK_GEO_RADIUS_M=
# [необязательно] Возрастная метка объявлений, например 0+, 16+, 18+. По умолчанию — по нише (0+, «взрослые» услуги 18+).
# VK_AGE_RESTRICTIONS=
# [необязательно] НДС для сумм VK Рекламы (лимит отправляем без НДС, расход пересчитываем с НДС); 0 — если суммы в кабинете уже с НДС.
# VK_ADS_VAT=0.22
# [необязательно] Переопределение адреса API (для тестов и прокси).
# VK_ADS_API_URL=https://ads.vk.com/api

# ─── Yandex Cloud: YandexGPT, YandexART, Wordstat (AI Studio) ─
# [рекомендуется] console.yandex.cloud → каталог → Сервисные аккаунты → создать с ролями:
#   ai.languageModels.user   — YandexGPT (тексты объявлений, переписывание, синонимы);
#   ai.imageGeneration.user  — YandexART (картинки для объявлений);
#   search-api.webSearch.user — Search API v2 → Wordstat (спрос по фразам).
# Затем у сервисного аккаунта → «Создать API-ключ» с областями (scopes):
#   yc.ai.languageModels.execute, yc.ai.imageGeneration.execute, yc.search-api.execute
# Пусто → тексты из шаблонов ниш, без генерации картинок, спрос по Wordstat не считается (Wordstat в API Директа отключён — код 509).
YANDEX_CLOUD_API_KEY=
# ID каталога, b1g…
YANDEX_CLOUD_FOLDER_ID=
# [на ВМ Yandex Cloud] 1 — без API-ключа: IAM-токен сервисного аккаунта ВМ из сервиса метаданных (роли те же, что выше).
# На ВМ из deploy/vm ставится автоматически.
# YANDEX_CLOUD_METADATA_IAM=
# [необязательно] yandexgpt/latest (качество, по умолчанию) или yandexgpt-lite/latest (дешевле)
YANDEX_GPT_MODEL=yandexgpt/latest
# [необязательно] Модель YandexART. По умолчанию пробуются yandex-art-2.0/latest, затем yandex-art/latest
# (старая модель для новых каталогов закрыта — 403).
# YANDEX_ART_MODEL=
# [необязательно] off — не использовать Wordstat в Yandex Cloud (останется Wordstat Директа v4 по токену кабинета).
# YANDEX_WORDSTAT_CLOUD=
# [необязательно] Адрес Search API Wordstat (для тестов и прокси).
# YANDEX_WORDSTAT_URL=https://searchapi.api.cloud.yandex.net/v2/wordstat/topRequests
# [необязательно] 1 — отдавать в /api/launch/demand поле debug (последняя ошибка, сырые ответы v4; токены вычищены).
# По умолчанию выключено: включайте только на время диагностики.
# DEMAND_DEBUG=

# ─── Квоты на платные вызовы (на пользователя в сутки, сутки по Москве) ─
# [необязательно] Превышение → ответ 429 с понятным текстом. Демо-аккаунты — свои, намного меньшие лимиты.
#                                   по умолчанию: обычный / демо
# QUOTA_COPY_DAY=20               # подготовка объявлений (YandexGPT)            20 / 3 (демо — только шаблоны)
# QUOTA_REWRITE_DAY=30            # «Переписать тексты», за порцию              30 / 3
# QUOTA_IMAGES_DAY=60             # порция картинок YandexART (~20 с работы)     60 / 20
# QUOTA_VARIANT_DAY=60            # новый вариант объявления (A/B, «ещё»)        60 / 5
# QUOTA_DEMAND_DAY=10             # новый сбор спроса по Wordstat (перезапуск)   10 / 3
# QUOTA_WORDSTAT_DAY=300          # фраз в Wordstat Yandex Cloud                 300 / 0 (демо — демо-данные)
# Демо-лимиты: QUOTA_DEMO_COPY_DAY, QUOTA_DEMO_REWRITE_DAY, QUOTA_DEMO_IMAGES_DAY, QUOTA_DEMO_VARIANT_DAY, QUOTA_DEMO_DEMAND_DAY, QUOTA_DEMO_WORDSTAT_DAY
# Общие лимиты на весь сервис в сутки — страховка счёта в Yandex Cloud:
# QUOTA_GLOBAL_AI_DAY=3000        # все генерации (copy + rewrite + images + variant + demand) вместе
# QUOTA_GLOBAL_WORDSTAT_DAY=3000  # фраз Wordstat в Yandex Cloud

# ─── Автозаполнение анкеты по ссылке (необязательно) ─────────
# Без ключей работает: сайт (schema.org, прайс), публичные страницы Яндекс Карт и 2ГИС, Taplink, DIKIDI.
# Ключи — запасной путь, если площадка не отдаёт страницу роботу (капчу сервис не обходит).
# 2ГИС Places API: platform.2gis.ru → ключ «Places API» (catalog.api.2gis.com/3.0/items/byid)
# DGIS_API_KEY=
# Яндекс «API поиска по организациям»: developer.tech.yandex.ru → ключ «API Поиска по организациям» (search-maps.yandex.ru/v1)
# YANDEX_PLACES_API_KEY=

# ─── Геокодирование адреса (показы VK в радиусе) — необязательно ─
# Геокодер Яндекса: developer.tech.yandex.ru → «JavaScript API и HTTP Геокодер». Пусто → Nominatim (OpenStreetMap, бесплатно).
# YANDEX_GEOCODER_KEY=
# Nominatim: свой сервер, e-mail для связи (просят правила OSM), User-Agent и страны поиска.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_EMAIL=
# GEOCODER_USER_AGENT=Samohod/1.0 (+https://ваш-домен)
# GEOCODER_COUNTRIES=ru

# ─── Telegram: заявки и утренняя сводка владельцу ────────────
# [рекомендуется] @BotFather → /newbot → токен. Вебхук {APP_URL}/api/notify/telegram ставится сам при https-адресе.
# Бот присылает заявки с кнопками «Записался / Не дозвонились / Спам», сводку с кнопками «Отменить»
# и предупреждение, когда деньги в кабинете кончатся через ≤ 3 дня.
# Пусто → уведомлений нет.
TELEGRAM_BOT_TOKEN=
# [необязательно] Имя бота без @. Пусто → узнаём через getMe.
# TELEGRAM_BOT_USERNAME=
# [необязательно] Свой адрес Bot API (Local Bot API или прокси), если api.telegram.org недоступен с хостинга.
# TELEGRAM_API_URL=https://api.telegram.org

# ─── Клиентская часть ────────────────────────────────────────
# [необязательно] Адрес сервиса для кода в браузере (ссылки на страницу записи). Пусто → адрес открытой страницы.
# NEXT_PUBLIC_APP_URL=

# ─── Задаёт платформа сама — вручную не указывать ────────────
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, VERCEL_PROJECT_ID, NODE_ENV
# PORT — Docker / Serverless Containers (по умолчанию 8080)

# ─── GitHub Actions (Settings → Secrets and variables → Actions), не переменные сервиса ─
# APP_URL, CRON_SECRET     — optimizer.yml (робот каждые 2 часа)
# DATABASE_URL (direct, не pooled), BACKUP_PASSPHRASE — backup.yml (ночной зашифрованный pg_dump, артефакт на 7 дней)
