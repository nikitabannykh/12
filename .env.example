# ─── Основное ────────────────────────────────────────────────
# Адрес сервиса без слэша в конце. Нужен для OAuth-редиректов и ссылок в объявлениях.
APP_URL=http://localhost:3000
# Случайная строка 32+ символов: подпись сессий и шифрование токенов кабинетов.
# Сгенерировать: openssl rand -hex 32
APP_SECRET=

# База данных. Пусто → локальная PGlite в папке .data (только для разработки).
# Продакшен: строка подключения Postgres (например, Neon, pooled-URL).
DATABASE_URL=

# Секрет для запуска оптимизатора по расписанию (/api/cron/run?key=...)
CRON_SECRET=

# Демо-вход и демо-кабинет без настоящих площадок (true/false).
ALLOW_DEMO=true

# ─── Вход через Google ───────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Яндекс Директ + Метрика ─────────────────────────────────
# Приложение на oauth.yandex.ru с правами: direct:api, metrika:read, metrika:write
# Redirect URI: {APP_URL}/api/connect/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# true → работать с песочницей Директа (api-sandbox.direct.yandex.com)
YANDEX_DIRECT_SANDBOX=false

# ─── VK Реклама ──────────────────────────────────────────────
# Доступ к API выдаёт поддержка VK Рекламы (ads.vk.com/help/articles/help_api).
# Redirect URI для Authorization Code: {APP_URL}/api/connect/vk/callback
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=

# ─── Генерация: YandexGPT + YandexART (Yandex Cloud) ─────────
# Сервисный аккаунт с ролями ai.languageModels.user и ai.imageGeneration.user
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
# Модель текста: yandexgpt/latest (качество) или yandexgpt-lite/latest (дешевле)
YANDEX_GPT_MODEL=yandexgpt/latest
